# ── App ──────────────────────────────────────────────
PORT=4000
DB_PATH=./data/launchdeck.db
WATCH_INTERVAL_SEC=60

# ── AEM ──────────────────────────────────────────────
# mock = read fixtures/aem/ ; live = call AEM over HTTP (GET only)
AEM_MODE=mock
AEM_FIXTURES_DIR=./fixtures/aem

# cloud = AEM as a Cloud Service ; 65 = AEM 6.5
AEM_FLAVOR=cloud
# devtoken | service (cloud only) | basic
AEM_AUTH=devtoken
AEM_HOST=
AEM_DEV_TOKEN=
AEM_USERNAME=
AEM_PASSWORD=
# Path to the AEMaaCS service credentials JSON (keep it outside the repo)
AEM_SERVICE_CREDENTIALS_PATH=

# Folder used by scripts/aem-smoke.ts
AEM_SMOKE_FOLDER=/content/dam
